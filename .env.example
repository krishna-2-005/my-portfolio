# Copy to .env.local (never commit that file) and fill in.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=kuchurusaikrishnareddy@gmail.com

# Optional. Sender address on a domain you verified in Resend.
# Without one, Resend's test sender (onboarding@resend.dev) is used, which can only
# deliver to the email address of your own Resend account.
CONTACT_FROM_EMAIL=

# Optional. Public URL of the deployed site (used for SEO/OG links).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=
